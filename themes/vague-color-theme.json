  "tokenColors": [
    {
      "name": "Comment",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#606079",
        "fontStyle": "italic"
      }
    },
    {
      "name": "String",
      "scope": [
        "string",
        "string.quoted",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#e8b589",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Regexp",
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#e8b589"
      }
    },
    {
      "name": "Escape",
      "scope": [
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#6e94b2"
      }
    },
    {
      "name": "Number",
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#e0a363"
      }
    },
    {
      "name": "Language constant",
      "scope": [
        "constant.language",
        "support.constant.builtin"
      ],
      "settings": {
        "foreground": "#e0a363",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Constant",
      "scope": [
        "constant",
        "constant.other",
        "variable.other.constant",
        "support.constant"
      ],
      "settings": {
        "foreground": "#aeaed1"
      }
    },
    {
      "name": "Keyword",
      "scope": [
        "keyword",
        "keyword.control",
        "storage",
        "storage.type",
        "storage.modifier",
        "meta.preprocessor",
        "entity.name.function.preprocessor"
      ],
      "settings": {
        "foreground": "#6e94b2"
      }
    },
    {
      "name": "Operator",
      "scope": [
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#90a0b5"
      }
    },
    {
      "name": "Function",
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#c48282"
      }
    },
    {
      "name": "Function call",
      "scope": [
        "meta.function-call entity.name.function",
        "meta.function-call.generic"
      ],
      "settings": {
        "foreground": "#bb9dbd"
      }
    },
    {
      "name": "Builtin function",
      "scope": [
        "support.function.builtin",
        "support.function.magic"
      ],
      "settings": {
        "foreground": "#c48282"
      }
    },
    {
      "name": "Type",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class",
        "entity.other.inherited-class"
      ],
      "settings": {
        "foreground": "#9bb4bc"
      }
    },
    {
      "name": "Builtin type",
      "scope": [
        "support.type.primitive",
        "support.type.builtin",
        "storage.type.primitive",
        "storage.type.built-in"
      ],
      "settings": {
        "foreground": "#b4d4cf",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Structure",
      "scope": [
        "entity.name.type.class",
        "entity.name.type.enum",
        "entity.name.type.interface",
        "entity.name.type.struct",
        "entity.name.type.type-parameter"
      ],
      "settings": {
        "foreground": "#aeaed1"
      }
    },
    {
      "name": "Namespace",
      "scope": [
        "entity.name.namespace",
        "entity.name.type.module"
      ],
      "settings": {
        "foreground": "#cdcdcd"
      }
    },
    {
      "name": "Variable",
      "scope": [
        "variable",
        "variable.other"
      ],
      "settings": {
        "foreground": "#cdcdcd"
      }
    },
    {
      "name": "Parameter",
      "scope": [
        "variable.parameter",
        "meta.parameter"
      ],
      "settings": {
        "foreground": "#bb9dbd"
      }
    },
    {
      "name": "Property",
      "scope": [
        "variable.other.property",
        "support.variable.property",
        "meta.object-literal.key",
        "support.type.property-name"
      ],
      "settings": {
        "foreground": "#c3c3d5"
      }
    },
    {
      "name": "Enum member",
      "scope": [
        "variable.other.enummember"
      ],
      "settings": {
        "foreground": "#b4d4cf"
      }
    },
    {
      "name": "Self reference",
      "scope": [
        "variable.language"
      ],
      "settings": {
        "foreground": "#b4d4cf"
      }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation",
        "meta.brace",
        "meta.delimiter"
      ],
      "settings": {
        "foreground": "#cdcdcd"
      }
    },
    {
      "name": "Tag",
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#b4d4cf"
      }
    },
    {
      "name": "Tag delimiter",
      "scope": [
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#cdcdcd"
      }
    },
    {
      "name": "Tag attribute",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#aeaed1"
      }
    },
    {
      "name": "Heading",
      "scope": [
        "markup.heading",
        "entity.name.section"
      ],
      "settings": {
        "foreground": "#6e94b2",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Bold",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "name": "Italic",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "name": "Link text",
      "scope": [
        "string.other.link",
        "markup.underline.link.image"
      ],
      "settings": {
        "foreground": "#e8b589",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Link URL",
      "scope": [
        "markup.underline.link",
        "string.other.link.description"
      ],
      "settings": {
        "foreground": "#c48282"
      }
    },
    {
      "name": "List marker",
      "scope": [
        "punctuation.definition.list.begin",
        "markup.list"
      ],
      "settings": {
        "foreground": "#c48282"
      }
    },
    {
      "name": "Inline code",
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code",
        "markup.raw"
      ],
      "settings": {
        "foreground": "#aeaed1"
      }
    },
    {
      "name": "Quote",
      "scope": [
        "markup.quote"
      ],
      "settings": {
        "foreground": "#606079"
      }
    },
    {
      "name": "Inserted",
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#7fa563"
      }
    },
    {
      "name": "Changed",
      "scope": [
        "markup.changed"
      ],
      "settings": {
        "foreground": "#f3be7c"
      }
    },
    {
      "name": "Deleted",
      "scope": [
        "markup.deleted"
      ],
      "settings": {
        "foreground": "#d8647e"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#d8647e"
      }
    }
  ],
  "semanticTokenColors": {
    "class": "#aeaed1",
    "enum": "#aeaed1",
    "interface": "#aeaed1",
    "struct": "#aeaed1",
    "type": "#9bb4bc",
    "typeParameter": "#aeaed1",
    "namespace": "#cdcdcd",
    "enumMember": "#b4d4cf",
    "function": "#bb9dbd",
    "function.declaration": "#c48282",
    "function.defaultLibrary": "#c48282",
    "method": "#9bb4bc",
    "macro": "#6e94b2",
    "parameter": "#bb9dbd",
    "selfParameter": "#b4d4cf",
    "property": "#9bb4bc",
    "variable": "#aeaed1",
    "variable.declaration": "#c3c3d5",
    "variable.defaultLibrary": {
      "foreground": "#e0a363",
      "fontStyle": "bold"
    },
    "variable.readonly": "#aeaed1",
    "comment": {
      "foreground": "#606079",
      "fontStyle": "italic"
    },
    "string": {
      "foreground": "#e8b589",
      "fontStyle": "italic"
    },
    "number": "#e0a363",
    "keyword": "#6e94b2",
    "operator": "#90a0b5",
    "regexp": "#e8b589",
    "builtinType": {
      "foreground": "#b4d4cf",
      "fontStyle": "bold"
    },
    "builtinConstant": {
      "foreground": "#e0a363",
      "fontStyle": "bold"
    }
  }
}
